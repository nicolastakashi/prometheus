groups:
  - id: registry.remote_write
    type: attribute_group
    brief: "Remote write attributes"
    attributes:
      - id: url
        type: string
        stability: stable
        brief: "The remote write endpoint"
        examples: ["http://remote.example.com/api/v1/write"]
  - id: metric.prometheus.remote_storage.failed_samples
    type: metric
    brief: "Samples which failed on send to remote storage"
    stability: stable
    metric_name: prometheus_remote_storage_failed_samples_total
    instrument: counter
    unit: "{sample}"
    attributes:
      - ref: url
        requirement_level: recommended
